[Unit]
Description=whisper-desk — voice dictation daemon
Documentation=https://github.com/SalvadorCardona/whisper-desk
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=@BIN@ daemon
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
